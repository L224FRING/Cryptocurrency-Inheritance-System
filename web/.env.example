# Copy to .env.local (or let web/scripts/deploy-local.sh generate it).
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_VDF_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_FROST_ADDRESS=0x0000000000000000000000000000000000000000

# Local demo only. Set to false to disable /api/dev/mine.
ALLOW_DEV_MINE=true

# Optional overrides (defaults are resolved relative to web/):
# FROST_REPO_ROOT=/path/to/Cryptocurrency-Inheritance-System
# FROST_SERVICE_BIN=/path/to/rust/frost-service/target/debug/frost-service
# FROST_RELAY_BIN=/path/to/rust/frost-service/target/debug/frost-relay
# FROST_STATE_DIR=/path/to/state
